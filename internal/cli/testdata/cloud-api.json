{
  "openapi": "3.1.0",
  "info": {
    "title": "Test API",
    "version": "3"
  },
  "paths": {
    "/rpc/getDashboard": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dashboardId": {
                    "type": "string"
                  },
                  "branch": {
                    "enum": [
                      "published",
                      "saved"
                    ]
                  }
                },
                "required": [
                  "dashboardId"
                ]
              }
            }
          }
        }
      }
    },
    "/rpc/listSharedEntryAccessBindings": {
      "post": {
        "description": "Returns the access bindings of the specified common object."
      }
    },
    "/rpc/getWorkbook": {
      "post": {
        "description": "Returns the specified workbook.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workbookId": {
                    "type": "string"
                  },
                  "includePermissionsInfo": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "workbookId"
                ]
              }
            }
          }
        }
      }
    },
    "/rpc/getTenantDetails": {
      "post": {
        "description": "Returns the current tenant state and public settings."
      }
    }
  }
}
